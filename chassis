#!/usr/bin/env python3
"""chassis — host CLI.

Subcommands wrap docker compose / docker exec to drive the container.
See `./chassis --help` for the command surface; the chassis is named
after the current git branch (`main` → `default`), namespacing
container/volumes/network so multiple chassis coexist on one host.
Override with CHASSIS_NAME=<name>.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path

__version__ = "0.2.0"

REPO = Path(__file__).resolve().parent
ENV_EXAMPLE = REPO / ".env.example"
ENV_FILE = REPO / ".env"
LLM_ENV_FILE = REPO / "harness" / "llm.env"
DASHBOARD_TUI = REPO / "dashboard" / "tui.py"
VAR_DIR = REPO / "var"
IMAGE_OVERRIDE = VAR_DIR / "compose.image.yaml"

# Where `chassis run --detach` keeps its bookkeeping, inside the logs volume so
# it survives a container restart and lands in any harvest of /var/log/chassis.
# Per handle: <h>.pgid (process-group id), <h>.task (agent TAB task), <h>.log
# (combined output), <h>.rc (exit status, written only on clean completion).
RUN_DIR = "/var/log/chassis/runs"


def chassis_name() -> str:
    """CHASSIS_NAME env wins; otherwise the current git branch is the chassis
    name (sanitized to docker-safe chars), with `main` falling back to
    `default` so a fresh clone produces a `default-chassis` rather than a
    `main-chassis`. Used to namespace container/volumes/network so multiple
    chassis can coexist on one host.
    """
    if os.environ.get("CHASSIS_NAME"):
        return os.environ["CHASSIS_NAME"]
    try:
        r = subprocess.run(
            ["git", "-C", str(REPO), "branch", "--show-current"],
            capture_output=True, text=True, check=False,
        )
        branch = r.stdout.strip()
    except FileNotFoundError:
        return "default"
    if not branch or branch == "main":
        return "default"
    safe = re.sub(r"[^a-z0-9._-]", "-", branch.lower()).lstrip("-")
    return safe or "default"


NAME = chassis_name()
CONTAINER = f"{NAME}-chassis"
PROJECT = f"{NAME}-chassis"


def attach_llm_container(chassis_container: str = CONTAINER) -> None:
    """If LLM_CONTAINER is set in harness/llm.env, attach it to the given
    chassis container's docker network with alias `llm`. Idempotent.
    """
    name = ""
    if LLM_ENV_FILE.exists():
        for line in LLM_ENV_FILE.read_text().splitlines():
            s = line.strip()
            if s.startswith("LLM_CONTAINER="):
                name = s.split("=", 1)[1].strip().strip('"').strip("'")
                break
    if not name:
        return
    inspect = run(
        ["docker", "inspect", chassis_container, "--format",
         "{{range $n, $_ := .NetworkSettings.Networks}}{{$n}}\n{{end}}"],
        capture_output=True, text=True,
    )
    if inspect.returncode != 0:
        return
    networks = [n for n in inspect.stdout.strip().splitlines() if n]
    if not networks:
        return
    run(
        ["docker", "network", "connect", "--alias", "llm", networks[0], name],
        capture_output=True, text=True,
    )


def detach_llm_container(chassis_container: str) -> None:
    """Reverse of attach_llm_container. Without this, `compose down -v` can't
    remove the network because vllm-server is still an active endpoint on it.
    """
    name = ""
    if LLM_ENV_FILE.exists():
        for line in LLM_ENV_FILE.read_text().splitlines():
            s = line.strip()
            if s.startswith("LLM_CONTAINER="):
                name = s.split("=", 1)[1].strip().strip('"').strip("'")
                break
    if not name:
        return
    inspect = run(
        ["docker", "inspect", chassis_container, "--format",
         "{{range $n, $_ := .NetworkSettings.Networks}}{{$n}}\n{{end}}"],
        capture_output=True, text=True,
    )
    if inspect.returncode != 0:
        return
    networks = [n for n in inspect.stdout.strip().splitlines() if n]
    if not networks:
        return
    run(
        ["docker", "network", "disconnect", networks[0], name],
        capture_output=True, text=True,
    )


def die(msg: str, code: int = 1) -> "None":
    print(f"chassis: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, **kwargs)


def host_default_limits() -> dict[str, str]:
    """Default the chassis container to 50% of host CPU + memory. Compose
    references these via ${CHASSIS_CPUS} / ${CHASSIS_MEM}; operators can
    pin specific values by exporting either before `./chassis up`."""
    out: dict[str, str] = {}
    if not os.environ.get("CHASSIS_CPUS"):
        cores = (os.cpu_count() or 2) * 0.5
        out["CHASSIS_CPUS"] = f"{cores:g}"
    if not os.environ.get("CHASSIS_MEM"):
        try:
            mem = int(os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") * 0.5)
        except (AttributeError, ValueError, OSError):
            mem = 2 * 1024 * 1024 * 1024  # 2 GiB fallback
        out["CHASSIS_MEM"] = str(mem)
    return out


def compose(args: list[str], **kwargs) -> subprocess.CompletedProcess:
    env = {**os.environ, "CHASSIS_NAME": NAME, **host_default_limits()}
    return run(
        ["docker", "compose", "--project-name", PROJECT, *args],
        cwd=REPO, env=env, **kwargs,
    )


def exec_in(cmd: list[str], *, user: str = "agent", interactive: bool = False) -> int:
    flags = ["-i"] if interactive else []
    if interactive and sys.stdout.isatty():
        flags.append("-t")
    return run(["docker", "exec", *flags, "-u", user, CONTAINER, *cmd]).returncode


def exec_script(script: str, *args: str, user: str = "agent"
                ) -> subprocess.CompletedProcess:
    """Run a bash script inside the container with the script on **stdin**.

    Never argv: a script piped in does not appear in the container's process
    list, so anything it interpolates stays out of `ps`. Positional args land
    as $1, $2, … (`bash -s <args>`).
    """
    return run(
        ["docker", "exec", "-i", "-u", user, CONTAINER, "bash", "-s", "--", *args],
        input=script, capture_output=True, text=True,
    )


def container_running() -> bool:
    ps = run(["docker", "ps", "--filter", f"name=^{CONTAINER}$", "--format", "{{.Names}}"],
             capture_output=True, text=True)
    return CONTAINER in (ps.stdout or "")


def require_container() -> None:
    if not container_running():
        die(f"{CONTAINER} is not running — run `chassis up` first.")


def agent_home() -> str:
    """The container's AGENT_HOME, matching run-agent's own fallback.

    Only set when an operator puts it in compose `environment:`/`env_file:`
    (e.g. per-user subdirs on a shared mount); otherwise /home/agent.
    """
    got = run(["docker", "exec", CONTAINER, "printenv", "AGENT_HOME"],
              capture_output=True, text=True)
    return (got.stdout or "").strip() or "/home/agent"


def image_present(ref: str) -> bool:
    return run(["docker", "image", "inspect", ref],
               capture_output=True, text=True).returncode == 0


def image_identity(ref: str) -> dict[str, object]:
    """`{"ref", "id", "digests"}` for a local image — what a run should record.

    The image id is the content hash of what actually ran; RepoDigests are the
    registry digests when the image came from (or was pushed to) one. An
    experiment that records these has the environment as a constant rather
    than a hope.
    """
    got = run(["docker", "image", "inspect", ref, "--format",
               "{{.Id}}\t{{json .RepoDigests}}"], capture_output=True, text=True)
    if got.returncode != 0:
        return {"ref": ref, "id": "", "digests": []}
    image_id, _, digests = (got.stdout or "").strip().partition("\t")
    try:
        parsed = json.loads(digests) if digests else []
    except ValueError:
        parsed = []
    return {"ref": ref, "id": image_id, "digests": parsed}


def cmd_init(_args: argparse.Namespace) -> int:
    if ENV_FILE.exists():
        print(f".env already exists at {ENV_FILE} — leaving it alone.")
        return 0
    if not ENV_EXAMPLE.exists():
        die(".env.example missing; can't scaffold")
    shutil.copy(ENV_EXAMPLE, ENV_FILE)
    ENV_FILE.chmod(0o600)
    print(f"wrote {ENV_FILE} (mode 600). Edit it before `./chassis up`.")
    return 0


def cmd_up(args: argparse.Namespace) -> int:
    """Start the chassis. By default builds this repo's Dockerfile; with
    `--image REF` (or CHASSIS_IMAGE) it runs a **prebuilt** image instead.

    That seam is what keeps this repo minimal. An image that needs a build
    toolchain, extra CLIs, or a whole research environment does not belong in
    the base Dockerfile — build it `FROM <chassis image>` downstream and point
    chassis at the result. Everything else (volumes, users, dispatcher, cron)
    is unchanged, because only the image tag moved.

    The resolved image id is printed, so a caller can record exactly what ran.
    """
    if not ENV_FILE.exists():
        die("no .env — run `./chassis init` first.")

    image = args.image or os.environ.get("CHASSIS_IMAGE") or ""
    if image:
        if not image_present(image):
            print(f"chassis: {image} not present locally — pulling")
            if run(["docker", "pull", image]).returncode != 0:
                die(f"cannot pull {image}; build it locally or fix the ref")
        # Overlay the image tag onto compose.yaml. `build:` stays in the base
        # file but never fires: compose only builds when the tagged image is
        # missing, and we just guaranteed it is not.
        VAR_DIR.mkdir(parents=True, exist_ok=True)
        IMAGE_OVERRIDE.write_text(
            _to_yaml({"services": {"chassis": {"image": image}}}))
        rc = compose(["-f", "compose.yaml", "-f", str(IMAGE_OVERRIDE),
                      "up", "-d"]).returncode
    elif args.no_build:
        rc = compose(["up", "-d"]).returncode
    else:
        rc = compose(["up", "-d", "--build"]).returncode

    if rc != 0:
        return rc
    attach_llm_container()

    identity = image_identity(image or f"{NAME}-chassis")
    print(f"chassis: image {identity['ref']} id {identity['id'] or '(unknown)'}")
    for digest in identity["digests"]:
        print(f"chassis: digest {digest}")
    return 0


def cmd_down(_args: argparse.Namespace) -> int:
    return compose(["down"]).returncode


def cmd_reload_cron(_args: argparse.Namespace) -> int:
    """Re-render /etc/chassis/tools-public.json and /etc/cron.d/chassis."""
    return run(
        ["docker", "exec", "-u", "root", CONTAINER,
         "/usr/local/bin/chassis-entrypoint", "--reload"]
    ).returncode


# Launch a task in its own session so the whole tree — run-agent, the harness
# CLI, anything either spawns — shares one process-group id we can signal later.
# The session leader's pid is the pgid, so `echo $$` after setsid records it.
DETACH_SH = r"""
set -eu
dir="$1"; handle="$2"; agent="$3"; task="$4"
mkdir -p "$dir"
printf '%s\t%s\n' "$agent" "$task" > "$dir/$handle.task"
: > "$dir/$handle.log"
setsid bash -c '
  dir=$1; handle=$2; agent=$3; task=$4
  echo $$ > "$dir/$handle.pgid"
  rc=0
  /usr/local/bin/run-agent "$agent" "$task" || rc=$?
  echo "$rc" > "$dir/$handle.rc"
' _ "$dir" "$handle" "$agent" "$task" >> "$dir/$handle.log" 2>&1 </dev/null &
# Wait for the pgid file so the handle is signalable the moment we return.
for _ in $(seq 1 100); do
  [ -s "$dir/$handle.pgid" ] && break
  sleep 0.05
done
"""

# TERM the process group, then KILL what is left. Signalling the group (not the
# pid) is the point: run-agent's child does the work, and a bare `kill $pid`
# would orphan it. The container and the agent home are untouched — that is
# what makes the next launch a genuine cold start rather than a resume.
KILL_SH = r"""
set -eu
dir="$1"; want_agent="$2"; want_task="$3"; want_handle="$4"
killed=0
shopt -s nullglob
for f in "$dir"/*.pgid; do
  handle="$(basename "$f" .pgid)"
  IFS=$'\t' read -r agent task < "$dir/$handle.task" 2>/dev/null || continue
  if [ -n "$want_handle" ]; then
    [ "$handle" = "$want_handle" ] || continue
  else
    [ "$agent" = "$want_agent" ] || continue
    [ -z "$want_task" ] || [ "$task" = "$want_task" ] || continue
  fi
  pgid="$(cat "$f")"
  if ! kill -0 -"$pgid" 2>/dev/null; then
    echo "not running: $handle"
    continue
  fi
  kill -TERM -"$pgid" 2>/dev/null || true
  for _ in $(seq 1 50); do
    kill -0 -"$pgid" 2>/dev/null || break
    sleep 0.1
  done
  kill -KILL -"$pgid" 2>/dev/null || true
  echo "killed $handle ($agent/$task, pgid $pgid)"
  killed=$((killed + 1))
done
[ "$killed" -gt 0 ] || echo "(nothing to kill)"
"""

RUNS_SH = r"""
set -eu
dir="$1"
shopt -s nullglob
found=0
for f in "$dir"/*.pgid; do
  handle="$(basename "$f" .pgid)"
  IFS=$'\t' read -r agent task < "$dir/$handle.task" 2>/dev/null || continue
  pgid="$(cat "$f")"
  if [ -f "$dir/$handle.rc" ]; then
    state="exit $(cat "$dir/$handle.rc")"
  elif kill -0 -"$pgid" 2>/dev/null; then
    state="running"
  else
    state="killed"
  fi
  printf '%s\t%s/%s\t%s\n' "$handle" "$agent" "$task" "$state"
  found=1
done
[ "$found" -eq 1 ] || echo "(no detached runs)"
"""


def cmd_run(args: argparse.Namespace) -> int:
    """Run an agent: interactive TUI, one-shot in the foreground, or detached.

    `--detach` exists because a controlled experiment needs *start, let it work
    for T, stop* — and cron cannot express that, while drift between two
    containers' crontabs is a confound. It prints a run handle on stdout and
    returns immediately; `chassis kill` takes that handle (or the agent name)
    back. Output lands in /var/log/chassis/runs/<handle>.log, exit status in
    the sibling <handle>.rc — both inside the logs volume, so a harvest gets
    them and a container restart does not.
    """
    if not args.detach:
        cmd = ["/usr/local/bin/run-agent", args.agent]
        if args.task:
            cmd.append(args.task)
        return exec_in(cmd, user="agent", interactive=args.task is None)

    if not args.task:
        die("--detach needs a task (there is nothing to detach an interactive session from)")
    require_container()
    handle = f"{args.agent}-{args.task}-{int(time.time())}-{uuid.uuid4().hex[:6]}"
    got = exec_script(DETACH_SH, RUN_DIR, handle, args.agent, args.task)
    if got.returncode != 0:
        sys.stderr.write(got.stderr)
        die(f"could not launch {args.agent}/{args.task}")
    print(handle)
    return 0


def cmd_kill(args: argparse.Namespace) -> int:
    """Stop detached runs — by handle, or by agent (optionally narrowed to one
    task). Leaves the container and the agent home intact."""
    if not args.agent and not args.handle:
        die("kill needs an agent name or --handle (refusing to stop every run)")
    require_container()
    got = exec_script(KILL_SH, RUN_DIR, args.agent or "", args.task or "",
                      args.handle or "")
    sys.stdout.write(got.stdout)
    sys.stderr.write(got.stderr)
    return got.returncode


def cmd_runs(args: argparse.Namespace) -> int:
    """List detached runs: handle, agent/task, and running | exit N | killed."""
    require_container()
    got = exec_script(RUNS_SH, RUN_DIR)
    out = got.stdout
    if args.agent:
        out = "".join(line for line in out.splitlines(keepends=True)
                      if line.split("\t")[1:2] and
                      line.split("\t")[1].split("/")[0] == args.agent)
        out = out or "(no detached runs)\n"
    sys.stdout.write(out)
    sys.stderr.write(got.stderr)
    return got.returncode


AGENT_NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*$")


def cmd_agent_add(args: argparse.Namespace) -> int:
    """Install an agent directory from the host into the running chassis.

    Agent dirs live on the agent-home volume, seeded once from the image's
    template — so until now the only way to add one from outside was `docker
    cp` by hand, with the uid-2000 chown that makes it usable left as an
    exercise. This does both, validates agent.json before copying anything,
    and re-renders cron so a task directory carrying a `cron` file is live
    immediately.

    Re-adding an existing agent overlays it (docker cp merges), which is what
    you want when iterating on a prompt.
    """
    src = Path(args.dir).expanduser()
    if not src.is_dir():
        die(f"{src} is not a directory")
    src = src.resolve()

    manifest = src / "agent.json"
    if not manifest.is_file():
        die(f"{src} has no agent.json — that file is what makes a directory an agent")
    try:
        json.loads(manifest.read_text())
    except ValueError as exc:
        die(f"{manifest} is not valid JSON: {exc}")

    name = args.name or src.name
    if not AGENT_NAME_RE.fullmatch(name):
        die(f"bad agent name {name!r}: use letters, digits, dot, dash, underscore "
            "(and not a leading dot — the entrypoint's globs skip dotfiles)")

    require_container()
    home = agent_home()
    dst = f"{home}/{name}"

    rc = run(["docker", "exec", "-u", "root", CONTAINER,
              "install", "-d", "-m", "755", "-o", "agent", "-g", "agent", dst]).returncode
    if rc != 0:
        die(f"could not create {dst} in {CONTAINER}")
    # `<src>/.` copies the *contents*, so the destination directory we just
    # created (with the right owner) is the one that survives.
    rc = run(["docker", "cp", f"{src}{os.sep}.", f"{CONTAINER}:{dst}"]).returncode
    if rc != 0:
        die(f"docker cp of {src} failed")
    rc = run(["docker", "exec", "-u", "root", CONTAINER,
              "chown", "-R", "2000:2000", dst]).returncode
    if rc != 0:
        die(f"could not chown {dst} to the agent user")

    print(f"chassis: installed agent {name!r} at {dst}")
    return cmd_reload_cron(args)


def cmd_logs(args: argparse.Namespace) -> int:
    if args.agent:
        target = f"/var/log/chassis/agents/{args.agent}"
        return exec_in(
            ["sh", "-c", f'find "{target}" -type f -name "*.jsonl" -printf "%T@ %p\\n" 2>/dev/null '
                          f'| sort -n | tail -20 | awk "{{print \\$2}}" | xargs -r tail -n +1'],
            user="agent",
        )
    return exec_in(
        ["sh", "-c", "tail -n 50 /var/log/chassis/run-tool.jsonl"],
        user="agent",
    )


def cmd_shell(args: argparse.Namespace) -> int:
    user = "root" if args.root else "agent"
    return exec_in(["bash"], user=user, interactive=True)


def cmd_test(args: argparse.Namespace) -> int:
    """Spin up a throwaway, fully-namespaced chassis, run a test script
    inside it, then tear everything down. The test image is reused across
    runs (tag `chassis-test:latest`); container/volumes/network are unique
    per run and removed by `compose down -v`.

    --set KEY=VAL overrides go into the container's `environment:`, which
    takes precedence over harness/llm.env (and over .env's LLM_API_KEY,
    thanks to the entrypoint preferring env over the file).
    """
    if not ENV_FILE.exists():
        die("no .env — run `./chassis init` first (the bind mount needs a real file).")

    test_script = REPO / "harness" / "tests" / args.name
    if not test_script.exists():
        die(f"no test {args.name!r} at {test_script}")

    overrides: list[tuple[str, str]] = []
    for kv in args.set or []:
        if "=" not in kv:
            die(f"--set requires KEY=VAL, got {kv!r}")
        k, v = kv.split("=", 1)
        overrides.append((k, v))

    test_id = f"test-{uuid.uuid4().hex[:8]}"
    test_project = f"{test_id}-chassis"
    test_container = f"{test_id}-chassis"
    test_image = "chassis-test:latest"

    # Override compose file: pin image tag (so we don't pile up images
    # across runs), disable restart, inject env overrides.
    override = {
        "services": {
            "chassis": {
                "image": test_image,
                "restart": "no",
                **({"environment": {k: v for k, v in overrides}} if overrides else {}),
            }
        }
    }
    override_yaml = _to_yaml(override)

    with tempfile.NamedTemporaryFile("w", suffix=".yaml", delete=False) as f:
        f.write(override_yaml)
        override_path = f.name

    env = {**os.environ, "CHASSIS_NAME": test_id}

    def compose_t(cmd: list[str], **kw) -> subprocess.CompletedProcess:
        return subprocess.run(
            ["docker", "compose", "--project-name", test_project,
             "-f", "compose.yaml", "-f", override_path, *cmd],
            cwd=REPO, env=env, **kw,
        )

    print(f"[{test_id}] build + up")
    try:
        rc = compose_t(["up", "-d", "--build"]).returncode
        if rc != 0:
            return rc

        attach_llm_container(test_container)

        print(f"[{test_id}] waiting for entrypoint")
        ready = False
        for _ in range(60):
            check = subprocess.run(
                ["docker", "exec", test_container, "test", "-f",
                 "/run/chassis-ready"],
                capture_output=True,
            )
            if check.returncode == 0:
                ready = True
                break
            time.sleep(0.5)
        if not ready:
            print(f"[{test_id}] entrypoint never finished — container logs:")
            subprocess.run(["docker", "logs", test_container])
            return 1

        print(f"[{test_id}] running {args.name}")
        subprocess.run(
            ["docker", "cp", str(test_script), f"{test_container}:/tmp/chassis-test"],
            check=True,
        )
        subprocess.run(
            ["docker", "exec", "-u", "root", test_container,
             "chmod", "+x", "/tmp/chassis-test"],
            check=True,
        )
        # Allocate a TTY when the operator is on one, so interactive tests
        # (e.g. `driver`, which drops into the pi TUI) are usable. Headless
        # tests (ping) don't care either way.
        exec_flags = ["-i"]
        if sys.stdout.isatty():
            exec_flags.append("-t")
        result = subprocess.run(
            ["docker", "exec", *exec_flags, "-u", "agent", test_container, "/tmp/chassis-test"],
        )
        return result.returncode
    finally:
        print(f"[{test_id}] teardown")
        detach_llm_container(test_container)
        compose_t(["down", "-v", "--remove-orphans"], capture_output=True)
        try:
            os.unlink(override_path)
        except OSError:
            pass


def _to_yaml(obj, indent: int = 0) -> str:
    """Minimal dict/list → YAML emitter so we don't depend on PyYAML.
    All scalars round-trip safely through JSON."""
    pad = "  " * indent
    if isinstance(obj, dict):
        if not obj:
            return "{}\n"
        out = ""
        for k, v in obj.items():
            if isinstance(v, (dict, list)) and v:
                out += f"{pad}{k}:\n{_to_yaml(v, indent + 1)}"
            else:
                out += f"{pad}{k}: {json.dumps(v)}\n"
        return out
    if isinstance(obj, list):
        return "".join(f"{pad}- {json.dumps(x)}\n" for x in obj)
    return f"{pad}{json.dumps(obj)}\n"


WRAPPER_MARKER_BEGIN = "# chassis-wrapper-begin"
WRAPPER_SH = r"""
# chassis-wrapper-begin — run ./chassis from any worktree (idempotent; safe to keep)
chassis() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "chassis: not in a git repo" >&2; return 1; }
  if [ ! -x "$root/chassis" ]; then
    echo "chassis: $root has no executable ./chassis script" >&2
    return 1
  fi
  "$root/chassis" "$@"
}
# chassis-wrapper-end
"""


def cmd_install(args: argparse.Namespace) -> int:
    """Append a `chassis` shell function to the user's rc file so the CLI is
    invokable as `chassis` from any worktree (and any subdirectory of one).
    Idempotent: rerunning is a no-op once the marker is present.

    --print emits the wrapper to stdout without touching any rc file — handy
    for non-bash/zsh shells or for piping into a custom location.
    """
    if args.print:
        sys.stdout.write(WRAPPER_SH)
        return 0

    rc_map = {"bash": ".bashrc", "zsh": ".zshrc"}
    shell_name = Path(os.environ.get("SHELL", "")).name
    if shell_name not in rc_map:
        print(
            f"chassis: SHELL is {shell_name or '(unset)'!r}; only bash and zsh "
            "are auto-installed. Run `./chassis install --print` and paste the "
            "output into your shell's rc file.",
            file=sys.stderr,
        )
        return 1
    rc = Path.home() / rc_map[shell_name]

    if rc.exists() and WRAPPER_MARKER_BEGIN in rc.read_text():
        print(f"chassis: wrapper already present in {rc} — nothing to do.")
        return 0

    with rc.open("a") as f:
        f.write(WRAPPER_SH)
    print(f"chassis: appended wrapper to {rc}.")
    print(f"chassis: run `source {rc}` (or open a new shell) to activate.")
    return 0


def cmd_status(_args: argparse.Namespace) -> int:
    ps = run(
        ["docker", "ps", "--filter", f"name={CONTAINER}", "--format",
         "{{.Names}}\t{{.Status}}\t{{.RunningFor}}"],
        capture_output=True, text=True,
    )
    print(f"=== container ({NAME}) ===")
    print(ps.stdout.strip() or f"{CONTAINER}: not running")
    if not ps.stdout.strip():
        return 0
    print()
    print("=== /etc/cron.d/chassis ===")
    exec_in(["cat", "/etc/cron.d/chassis"], user="root")
    print()
    print("=== triggers ===")
    # Trigger files aren't pre-rendered (parsed at fire time in run-agent), so
    # surface them directly. Format: <dst-agent>/<dst-task> <- <kind> <src>.
    exec_in(
        ["sh", "-c",
         "found=0; "
         "for f in /home/agent/*/*/trigger; do "
         "  [ -f \"$f\" ] || continue; "
         "  line=$(grep -v '^[[:space:]]*#' \"$f\" | grep -v '^[[:space:]]*$' | head -1); "
         "  [ -z \"$line\" ] && continue; "
         "  d=$(dirname \"$f\"); "
         "  task=$(basename \"$d\"); agent=$(basename $(dirname \"$d\")); "
         "  printf '%s/%s  <-  %s\\n' \"$agent\" \"$task\" \"$line\"; "
         "  found=1; "
         "done; [ $found -eq 0 ] && echo '(no triggers)'"],
        user="agent",
    )
    print()
    print("=== last 5 run-tool entries ===")
    exec_in(
        ["sh", "-c", "tail -n 5 /var/log/chassis/run-tool.jsonl 2>/dev/null || echo '(no audit log yet)'"],
        user="agent",
    )
    return 0


def cmd_tui(args: argparse.Namespace) -> int:
    """Launch the btop-style terminal monitor (dashboard/tui.py) against this
    branch's chassis. The TUI shells out to docker itself, so this just spawns
    it with the right target. Prefer `uv` so its lone dep (croniter) resolves;
    fall back to plain python (next-fire times go blank without croniter)."""
    if not DASHBOARD_TUI.exists():
        die(f"{DASHBOARD_TUI} missing")
    target = args.chassis or CONTAINER
    extra = ["--chassis", target]
    if args.interval is not None:
        extra += ["--interval", str(args.interval)]
    if shutil.which("uv"):
        launcher = ["uv", "run", "--script", str(DASHBOARD_TUI)]
    else:
        launcher = [sys.executable, str(DASHBOARD_TUI)]
    return run([*launcher, *extra]).returncode


HELP_DESCRIPTION = """\
chassis — host CLI for a Docker-based agent fleet.

Each chassis is namespaced by the current git branch (override via
CHASSIS_NAME); `main` becomes `default`, so several chassis can coexist
on one host.
"""

HELP_EPILOG = """\
common workflows:
  first run        chassis init && chassis up && chassis run driver
  attach driver    chassis run driver
  prebuilt image   chassis up --image myorg/derived-chassis:sha-abc123
  install an agent chassis agent add ./missions/counter
  timed run        h=$(chassis run counter session --detach); sleep 600; chassis kill counter
  after tools/     chassis reload-cron
  smoke test       chassis test ping
  tool sandbox     chassis test driver

run `chassis <command> --help` for command-specific options.
"""


def main() -> int:
    p = argparse.ArgumentParser(
        prog="chassis",
        description=HELP_DESCRIPTION,
        epilog=HELP_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--version", action="version", version=f"chassis {__version__}")
    sub = p.add_subparsers(
        dest="cmd",
        required=True,
        metavar="<command>",
        title="commands",
    )

    # lifecycle
    sub.add_parser("init",        help="scaffold .env from .env.example (mode 600)").set_defaults(func=cmd_init)

    p_up = sub.add_parser("up",   help="build (or run a prebuilt image) + start the chassis container")
    p_up.add_argument("--image", metavar="REF", default=None,
                      help="run this prebuilt image instead of building (env: CHASSIS_IMAGE); "
                           "pulled if it is not present locally")
    p_up.add_argument("--no-build", action="store_true",
                      help="start from the existing local image without rebuilding")
    p_up.set_defaults(func=cmd_up)

    sub.add_parser("down",        help="stop the chassis container").set_defaults(func=cmd_down)
    sub.add_parser("status",      help="container state + cron file + recent log activity").set_defaults(func=cmd_status)

    # agent interaction
    p_run = sub.add_parser("run", help="run an agent (interactive if no task, one-shot otherwise)")
    p_run.add_argument("agent", help="agent name under /home/agent/")
    p_run.add_argument("task", nargs="?", default=None, help="optional task name for one-shot mode")
    p_run.add_argument("--detach", "-d", action="store_true",
                       help="launch the task in the background and print a run handle "
                            "(requires a task; stop it with `chassis kill`)")
    p_run.set_defaults(func=cmd_run)

    p_kill = sub.add_parser("kill", help="stop a detached run (container and agent home survive)")
    p_kill.add_argument("agent", nargs="?", default=None, help="agent whose runs to stop")
    p_kill.add_argument("task", nargs="?", default=None, help="narrow to one task of that agent")
    p_kill.add_argument("--handle", default=None, help="stop exactly this run handle instead")
    p_kill.set_defaults(func=cmd_kill)

    p_runs = sub.add_parser("runs", help="list detached runs and their state")
    p_runs.add_argument("agent", nargs="?", default=None, help="filter to one agent")
    p_runs.set_defaults(func=cmd_runs)

    p_agent = sub.add_parser("agent", help="manage agent definitions on the agent-home volume")
    agent_sub = p_agent.add_subparsers(dest="agent_cmd", required=True, metavar="<subcommand>")
    p_agent_add = agent_sub.add_parser("add", help="install an agent directory from the host")
    p_agent_add.add_argument("dir", help="host directory containing agent.json (+ SYSTEM.md, task dirs)")
    p_agent_add.add_argument("--name", default=None, help="install under this name (default: the directory's)")
    p_agent_add.set_defaults(func=cmd_agent_add)

    p_shell = sub.add_parser("shell", help="open a shell in the container (default: agent user)")
    p_shell.add_argument("--root", action="store_true", help="open as root instead of agent")
    p_shell.set_defaults(func=cmd_shell)

    p_logs = sub.add_parser("logs", help="tail dispatcher audit log, or per-agent run logs")
    p_logs.add_argument("agent", nargs="?", default=None, help="agent name; omit for dispatcher audit log")
    p_logs.set_defaults(func=cmd_logs)

    p_tui = sub.add_parser("tui", help="btop-style terminal monitor (CPU/mem graphs, tasks, audit, triggers)")
    p_tui.add_argument("--chassis", metavar="NAME", default=None,
                       help=f"container to monitor (default: this branch's {CONTAINER})")
    p_tui.add_argument("--interval", type=float, default=None,
                       help="docker poll interval in seconds (default 2.0)")
    p_tui.set_defaults(func=cmd_tui)

    # maintenance
    sub.add_parser("reload-cron", help="re-render tools-public.json + cron (no restart)").set_defaults(func=cmd_reload_cron)

    p_install = sub.add_parser("install", help="add a `chassis` shell function to ~/.bashrc or ~/.zshrc")
    p_install.add_argument("--print", action="store_true",
                           help="print the wrapper to stdout instead of editing any rc file")
    p_install.set_defaults(func=cmd_install)

    p_test = sub.add_parser("test", help="run harness/tests/<name> in an ephemeral container")
    p_test.add_argument("name", help="script under harness/tests/ (e.g. ping)")
    p_test.add_argument("--set", action="append", metavar="KEY=VAL",
                        help="env override (repeatable); wins over harness/llm.env and .env")
    p_test.set_defaults(func=cmd_test)

    args = p.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
