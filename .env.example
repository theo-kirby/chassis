# Container timezone (passed through compose).
TZ=UTC

# LLM provider API key. Required for hosted endpoints (OpenRouter, OpenAI,
# Anthropic). Leave empty for local endpoints (vLLM, ollama) that ignore it.
# The base URL and model id live in harness/llm.env.
LLM_API_KEY=

# Secrets used by tools. Each tool declares the keys it needs in tools/tools.json:secrets.
# The dispatcher injects only declared keys into the tool's child env, and redacts every
# value here from tool stdout/stderr before forwarding to Pi.
#
# Tavily — web-search tool.
TAVILY_API_KEY=

