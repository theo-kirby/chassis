#!/usr/bin/env bash
#
# run-agent — drop privileges (when invoked as root) and run the underlying
# harness CLI (currently `pi`) with the chassis extension loaded. With a task,
# runs one-shot via --print using the task's INSTRUCTIONS.md as prompt, then
# fires any sibling trigger files that point at this (agent, task). Without
# a task, execs into the interactive TUI (no trigger fan-out).

set -euo pipefail

AGENT_HOME="${AGENT_HOME:-/home/agent}"

LOG_DIR=/var/log/chassis
TRIGGER_LOG="$LOG_DIR/triggers.log"

# After a task finishes, walk $AGENT_HOME/<a>/<t>/trigger and fire any task
# whose trigger points at the just-completed (agent, task). Grammar is one
# line, mirroring the cron file:
#   after      <agent>/<task>   # fires on any exit
#   on_success <agent>/<task>   # fires on exit 0
#   on_failure <agent>/<task>   # fires on non-zero exit
# Matches are detached with setsid so this wrapper exits promptly. Cycles
# (A->B->A) are intentional — they enable feedback loops. The operator can
# pkill -f run-agent if a loop misbehaves.
fire_triggers() {
    local src_agent="$1" src_task="$2" rc="$3"
    local accept
    if (( rc == 0 )); then
        accept=" after  on_success "
    else
        accept=" after  on_failure "
    fi
    # Verdict snapshot string — built once per fire_triggers call and reused in
    # every per-trigger log line. The VERDICT assoc array is a global written
    # by the caller from $CHASSIS_VERDICT_FILE.
    local verdict_str="" vk
    for vk in "${!VERDICT[@]}"; do verdict_str+="$vk=${VERDICT[$vk]},"; done
    verdict_str="${verdict_str%,}"

    local trigger_file
    for trigger_file in "$AGENT_HOME"/*/*/trigger; do
        [[ -f "$trigger_file" ]] || continue
        local line kind ref when_kw lhs op rhs
        line="$(grep -v '^[[:space:]]*#' "$trigger_file" | grep -v '^[[:space:]]*$' | head -1 || true)"
        [[ -z "$line" ]] && continue
        # Reset per-line so a previous iteration's `when` doesn't leak in.
        kind="" ref="" when_kw="" lhs="" op="" rhs=""
        read -r kind ref when_kw lhs op rhs _ <<<"$line"
        [[ -z "${kind:-}" || -z "${ref:-}" || "$ref" != */* ]] && continue
        [[ "$accept" == *" $kind "* ]] || continue

        local ref_agent="${ref%%/*}" ref_task="${ref##*/}"
        [[ "$ref_agent" == "$src_agent" && "$ref_task" == "$src_task" ]] || continue

        # Optional `when <key> <op> <value>` clause. A missing verdict key
        # means the trigger does not fire — every routing path must either
        # produce a verdict or fall through to a plain on_failure safety net.
        if [[ -n "${when_kw:-}" ]]; then
            [[ "$when_kw" == "when" ]] || continue
            [[ -n "${lhs:-}" && -n "${op:-}" && -n "${rhs:-}" ]] || continue
            local val="${VERDICT[$lhs]:-}"
            [[ -z "$val" ]] && continue
            case "$op" in
                "==") [[ "$val" == "$rhs" ]] || continue ;;
                "!=") [[ "$val" != "$rhs" ]] || continue ;;
                "<"|">"|"<="|">=")
                    [[ "$val" =~ ^-?[0-9]+$ && "$rhs" =~ ^-?[0-9]+$ ]] || continue
                    case "$op" in
                        "<")  (( val <  rhs )) || continue ;;
                        ">")  (( val >  rhs )) || continue ;;
                        "<=") (( val <= rhs )) || continue ;;
                        ">=") (( val >= rhs )) || continue ;;
                    esac ;;
                *) continue ;;
            esac
        fi

        local dst_dir dst_agent dst_task
        dst_dir="$(dirname "$trigger_file")"
        dst_task="$(basename "$dst_dir")"
        dst_agent="$(basename "$(dirname "$dst_dir")")"

        local when_str=""
        [[ -n "${when_kw:-}" ]] && when_str=" when ${lhs} ${op} ${rhs}"

        mkdir -p "$LOG_DIR"
        printf '[%s] trigger %s/%s (%s rc=%d verdict={%s}) -> %s/%s%s\n' \
            "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
            "$src_agent" "$src_task" "$kind" "$rc" "$verdict_str" \
            "$dst_agent" "$dst_task" "$when_str" >>"$TRIGGER_LOG"

        setsid /usr/local/bin/run-agent "$dst_agent" "$dst_task" \
            >>"$TRIGGER_LOG" 2>&1 </dev/null &
        disown $! 2>/dev/null || true
    done
}

agent="${1:-}"
task="${2:-}"

if [[ -z "$agent" ]]; then
    echo "Usage: run-agent <agent> [task]" >&2
    exit 1
fi

export CHASSIS_AGENT="$agent"
export CHASSIS_TASK="$task"

extra=()
prompt=""

if [[ -n "$task" ]]; then
    instructions="$AGENT_HOME/$agent/$task/INSTRUCTIONS.md"
    if [[ ! -f "$instructions" ]]; then
        echo "run-agent: task instructions not found at $instructions" >&2
        exit 1
    fi
    prompt="$(cat "$instructions")"
    # --print: non-interactive; pi processes the prompt and exits.
    # Session is kept so the per-agent run log can record session_file and
    # the operator can replay the model's reasoning if a task misbehaves.
    extra+=(--print)

    # Per-run verdict file. The `verdict` tool appends k=v lines here; after
    # pi exits we slurp them into the VERDICT assoc array so fire_triggers
    # can evaluate `when` clauses against the task's published verdicts.
    # $$-$(date +%s%N) keeps the path unique across overlapping runs.
    #
    # Deliberately NOT /tmp, which is where this lived and where it did not
    # work. This file is created by the agent user and appended to by the
    # dispatcher running as root, and `fs.protected_regular` refuses an
    # O_CREAT open of a file in a world-writable **sticky** directory when the
    # file's owner matches neither the directory's owner nor the caller — root
    # included, because the check runs before the capability check. Every
    # verdict call came back `PermissionError: [Errno 13]` and the task still
    # exited 0. $LOG_DIR is not sticky, so the two uids can share a file there.
    VERDICT_DIR="$LOG_DIR/verdicts"
    mkdir -p "$VERDICT_DIR" 2>/dev/null || true
    CHASSIS_RUN_ID="${agent}-${task}-$$-$(date +%s%N)"
    export CHASSIS_VERDICT_FILE="$VERDICT_DIR/${CHASSIS_RUN_ID}"
    : > "$CHASSIS_VERDICT_FILE"
fi

# Resolve which model pi should use. agent.json:model is the per-agent
# override (a pattern like "llm/Qwen/Qwen3-4B" or a glob like "*Qwen3*").
# When unset, fall back to the chassis default — composed from the
# LLM_MODEL_ID env var (sourced from harness/llm.env).
AGENT_JSON="$AGENT_HOME/$agent/agent.json"
model=""
if [[ -f "$AGENT_JSON" ]]; then
    model="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("model","") or "")' "$AGENT_JSON")"
fi
if [[ -z "$model" && -n "${LLM_MODEL_ID:-}" ]]; then
    model="llm/${LLM_MODEL_ID}"
fi
if [[ -n "$model" ]]; then
    extra+=(--model "$model")
fi

# Thinking level (off|minimal|low|medium|high|xhigh|empty). Sourced from
# LLM_THINKING in harness/llm.env.
if [[ -n "${LLM_THINKING:-}" ]]; then
    extra+=(--thinking "$LLM_THINKING")
fi

# /usr/local/lib/chassis-ext is the dist/ output of `tsc`; entry is index.js.
EXT=/usr/local/lib/chassis-ext/index.js

cmd=(pi "${extra[@]}" --no-builtin-tools -e "$EXT")
[[ -n "$prompt" ]] && cmd+=("$prompt")

# Run from the agent's workspace so docs/instructions can use relative paths
# like memory/ and user.json — they resolve correctly under any AGENT_HOME
# (including per-user subdirs on a shared mount).
cd "$AGENT_HOME"

# Interactive (no task): hand the tty to pi and exit. No trigger fan-out for
# operator-driven sessions; only scheduled/triggered tasks chain.
if [[ -z "$task" ]]; then
    if [[ $(id -u) -eq 0 ]]; then
        exec runuser -u agent -- env AGENT_HOME="$AGENT_HOME" CHASSIS_AGENT="$agent" CHASSIS_TASK="$task" "${cmd[@]}"
    else
        exec "${cmd[@]}"
    fi
fi

# One-shot task: run, capture rc (without tripping set -e), fan out triggers.
rc=0
if [[ $(id -u) -eq 0 ]]; then
    runuser -u agent -- env \
        AGENT_HOME="$AGENT_HOME" \
        CHASSIS_AGENT="$agent" \
        CHASSIS_TASK="$task" \
        CHASSIS_VERDICT_FILE="$CHASSIS_VERDICT_FILE" \
        "${cmd[@]}" || rc=$?
else
    "${cmd[@]}" || rc=$?
fi

# Slurp verdicts written by the task. Last-write-wins per key, so a task that
# revises a verdict mid-run gets its final value applied to routing. The file
# is owned by the task ($CHASSIS_VERDICT_FILE is exported and the verdict tool
# writes to that path), so we rm it after reading.
declare -A VERDICT
while IFS='=' read -r k v; do
    [[ -z "$k" || "$k" == \#* ]] && continue
    VERDICT["$k"]="$v"
done < "$CHASSIS_VERDICT_FILE" 2>/dev/null || true
rm -f "$CHASSIS_VERDICT_FILE"

fire_triggers "$agent" "$task" "$rc" || true
exit "$rc"
