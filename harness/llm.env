# LLM configuration — single source of truth for which model chassis talks to.
# Edit this file (committed; chassis branches override) when you swap the LLM.

# OpenAI-compatible HTTP endpoint. Host `llm` is wired by ./chassis up when
# LLM_CONTAINER is set; otherwise point at any endpoint chassis can reach.
# Examples:
#   local vLLM:  http://llm:8000/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   OpenAI:      https://api.openai.com/v1
# For hosted endpoints, set LLM_API_KEY in .env (this file is committed).
LLM_BASE_URL=https://openrouter.ai/api/v1

# Pi streaming API kind: openai-completions, anthropic-messages, google-generative-ai.
LLM_API_KIND=openai-completions

# Model id as advertised by the provider.
#   vLLM/local:  whatever `/v1/models` returns
#   OpenRouter:  vendor/model (e.g. anthropic/claude-sonnet-4-5, openai/gpt-5)
#LLM_MODEL_ID=Qwen/Qwen3.6-35B-A3B
LLM_MODEL_ID=anthropic/claude-sonnet-4.6

# Context window the LLM supports; pi caps max_tokens against this.
LLM_CONTEXT_WINDOW=60000
LLM_MAX_TOKENS=8192

# Thinking level passed to `pi --thinking`. Valid: off, minimal, low, medium,
# high, xhigh, or empty (let pi pick). Reasoning models burn output budget on
# a CoT preamble; default off for tight context windows.
LLM_THINKING=off

# Host-side: docker container name to attach to chassis-net with alias `llm`.
# Only read by ./chassis up. Leave empty if the LLM is reachable some other way.
LLM_CONTAINER=vllm-server
