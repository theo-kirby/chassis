# LLM configuration — single source of truth for which model chassis talks to.
#
# Authentication is interactive — run `./chassis login` once per chassis to
# persist credentials on the agent-home volume (/home/agent/.claude/). Every
# subsequent `chassis run` and every cron-fired task reuses that session, so
# there is no API key to configure here.

# Optional Claude Code model override. Leave empty to use Claude Code's own
# default. Examples: claude-sonnet-4-6, claude-opus-4-7, claude-haiku-4-5.
# Per-agent overrides live in /home/agent/<agent>/agent.json:model.
CLAUDE_MODEL=
